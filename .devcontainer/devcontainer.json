{
	"name": "Shortsmaker Infra",
	"dockerComposeFile": [
		"docker compose.yml"
	],
	"service": "devcontainer",
	"workspaceFolder": "/workspaces/shortsmaker/shortsmaker-infra",
	"postStartCommand": "bash .devcontainer/onstart.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-azuretools.vscode-docker",
				"redhat.vscode-yaml",
				"GitHub.copilot",
				"GitHub.copilot-chat"
			]
		}
	}
}
